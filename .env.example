# Upstox API credentials
# Get these by registering an app at https://upstox.com/developer/api-documentation/
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=

# Fernet key (urlsafe-base64-encoded 32-byte key) used to encrypt broker
# access tokens at rest before they are written to the database. Generate one
# with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required by src/broker_token_crypto.py -- the app will fail to start without it.
BROKER_TOKEN_ENCRYPTION_KEY=